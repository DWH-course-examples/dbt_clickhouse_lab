{
    "name": "dbt Development",
    "image": "my-dbt-dev:latest",
    "forwardPorts": [8080],
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "innoverio.vscode-dbt-power-user",
                "batisteo.vscode-dbt",
                "ms-python.python",
                "redhat.vscode-yaml"
            ]
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
    ]
}